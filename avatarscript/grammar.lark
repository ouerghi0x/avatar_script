// AvatarScript v0.1 Grammar (LALR + Indenter)

start: _NL* scene_def _NL*

scene_def: "scene" STRING ":" _NL _INDENT scene_item+ _DEDENT

?scene_item: canvas_stmt
           | background_stmt
           | fps_stmt
           | duration_stmt
           | avatar_def
           | render_stmt

canvas_stmt: "canvas" RESOLUTION _NL
background_stmt: "background" STRING _NL
fps_stmt: "fps" NUMBER _NL
duration_stmt: "duration" TIME _NL
render_stmt: "render" STRING _NL

avatar_def: "avatar" STRING ":" _NL _INDENT avatar_item+ _DEDENT

?avatar_item: character_stmt
            | position_stmt
            | scale_prop_stmt
            | rotation_prop_stmt
            | hold_stmt
            | idle_block
            | timeline_block

character_stmt: "character" STRING _NL
position_stmt: "position" position_spec _NL
scale_prop_stmt: "scale" SIGNED_NUMBER _NL
rotation_prop_stmt: "rotation" SIGNED_NUMBER _NL
hold_stmt: "hold" hold_param+ _NL

?hold_param: "item" ":" (STRING | NAME) -> hold_item
           | "hand" ":" (STRING | NAME) -> hold_hand
           | "scale" ":" SIGNED_NUMBER  -> hold_scale
           | "item" (STRING | NAME)     -> hold_item
           | "hand" (STRING | NAME)     -> hold_hand
           | "scale" SIGNED_NUMBER      -> hold_scale
           | (STRING | NAME)            -> hold_val

?position_spec: NAME -> named_pos
              | coord_pair -> coord_pos

coord_pair: "x" ":" SIGNED_NUMBER "y" ":" SIGNED_NUMBER

idle_block: "idle" ":" _NL _INDENT idle_item+ _DEDENT

?idle_item: breathe_stmt
          | blink_stmt

breathe_stmt: "breathe" _NL
blink_stmt: "blink" ("every" TIME)? _NL

timeline_block: "at" TIME ":" _NL _INDENT action_stmt+ _DEDENT

?action_stmt: expression_stmt
            | animate_stmt
            | direct_transform_stmt
            | hold_stmt

expression_stmt: "expression" NAME _NL
animate_stmt: "animate" NAME anim_param* _NL
direct_transform_stmt: TRANSFORM_KIND anim_param* _NL

TRANSFORM_KIND.2: "move" | "scale" | "rotate" | "fade" | "nod" | "arm" | "left_arm" | "right_arm" | "aura" | "shake" | "bounce"

?anim_param: "duration" TIME          -> param_duration
           | "easing" NAME            -> param_easing
           | "intensity" (":"? SIGNED_NUMBER) -> param_intensity
           | "color" (":"? (NAME | STRING))  -> param_color
           | "size" (":"? SIGNED_NUMBER)     -> param_size
           | "speed" (":"? SIGNED_NUMBER)    -> param_speed
           | "sparks" (":"? (NAME | SIGNED_NUMBER)) -> param_sparks
           | NAME ":" (SIGNED_NUMBER | STRING | NAME) -> param_kv
           | NAME                     -> param_name
           | SIGNED_NUMBER            -> param_val

RESOLUTION.2: /[0-9]+x[0-9]+/
TIME.2: /[0-9]+(\.[0-9]+)?s/
SIGNED_NUMBER: /[-+]?[0-9]+(\.[0-9]+)?/
NUMBER: /[0-9]+(\.[0-9]+)?/
STRING: /"[^"]*"/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

COMMENT: /#[^\r\n]*/
_NL: /(\r?\n[\t ]*(#[^\r\n]*)?)+/

%ignore /[\t ]+/
%ignore COMMENT
%declare _INDENT _DEDENT
